{
  "display_information": {
    "name": "Slack Dev Assistant",
    "description": "Save thread knowledge and review development work from Slack"
  },
  "features": {
    "bot_user": {
      "display_name": "slack-dev-assistant",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/duduk",
        "description": "Save domain knowledge or analyze a development request",
        "usage_hint": "save <thread-url> | analyze <thread-url> | status <job-id>",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}

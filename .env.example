# Copy to .env at the directory where you run the CLI. Never commit real tokens.
# Read token for thread collection (bot or user). Public channels need
# channels:history and channel access. An existing read-only token can stay here.
SLACK_TOKEN=

# Socket Mode worker only: bot OAuth token with commands, chat:write,
# channels:history. Reinstall the app after changing its scopes.
SLACK_BOT_TOKEN=

# Socket Mode worker only: app-level xapp- token with connections:write.
# This is separate from the bot OAuth token and cannot read channel messages.
SLACK_APP_TOKEN=

# Required for live analysis, knowledge extraction, planning and implementation.
# File-based fixtures can run without an OpenAI API key.
OPENAI_API_KEY=
